# Homologation defaults to synthetic data. For an explicitly approved
# read-only real-data validation, set homologation_data_mode = "real_readonly"
# and populate the dedicated service account and real spreadsheet ID in the
# Streamlit Homologation app Secrets only. Never use production credentials.
homologation_data_mode = "synthetic"
spreadsheet_id = "SYNTHETIC_ONLY"
gcp_service_account = {}

[auth]
redirect_uri = "https://EXACT_HOMOLOGATION_SUBDOMAIN.streamlit.app/oauth2callback"
cookie_secret = "GENERATE_PRIVATELY_AT_LEAST_32_RANDOM_BYTES"

[auth.google]
client_id = "HOMOLOGATION_CLIENT_ID.apps.googleusercontent.com"
client_secret = "HOMOLOGATION_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
client_kwargs = {scope = "openid email profile", prompt = "select_account", hd = "adtarget.com.br"}
