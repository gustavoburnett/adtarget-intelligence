# Synthetic acceptance app only. No service account key or real spreadsheet ID.
spreadsheet_id = "SYNTHETIC_ONLY"
gcp_service_account = {}

[auth]
redirect_uri = "https://EXACT_HOMOLOGATION_SUBDOMAIN.streamlit.app/oauth2callback"
cookie_secret = "GENERATE_PRIVATELY_AT_LEAST_32_RANDOM_BYTES"

[auth.google]
client_id = "HOMOLOGATION_CLIENT_ID.apps.googleusercontent.com"
client_secret = "HOMOLOGATION_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
client_kwargs = {scope = "openid email profile", prompt = "select_account", hd = "adtarget.com.br"}
